module "vm" {
  source   = "../vm"
  for_each = var.vms

  name             = each.key
  image            = coalesce(each.value.image, var.default_image)
  cpus             = each.value.cpus
  memory_mb        = each.value.memory_mb
  network_adapters = coalesce(each.value.network_adapters, var.default_network_adapters)
  status           = each.value.status
}

locals {
  ip_addresses = { for name, vm in module.vm : name => vm.primary_ipv4_addresses[name] }

  groups = distinct(flatten([for vm in values(var.vms) : vm.groups]))

  inventory = {
    all = {
      vars = merge(
        {
          ansible_user = var.ansible_user
          # VMs get recreated with fresh host keys; don't pin them.
          ansible_ssh_common_args = "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

          static_network_prefix      = tonumber(split("/", var.network.cidr)[1])
          static_network_gateway     = var.network.gateway
          static_network_dns_servers = var.network.dns_servers
        },
        var.ansible_ssh_private_key_file == null ? {} : { ansible_ssh_private_key_file = var.ansible_ssh_private_key_file },
        var.ansible_vars,
      )
      hosts = {
        for name, vm in var.vms : name => merge(
          vm.host_vars,
          {
            # Address the VM got from DHCP on first boot; the playbook moves
            # to static_ip once it's configured.
            ansible_host   = local.ip_addresses[name]
            static_ip      = vm.ip
            static_mac     = module.vm[name].primary_mac_addresses[name]
            extra_packages = vm.packages
          },
        )
      }
      children = {
        for group in local.groups : group => {
          hosts = { for name, vm in var.vms : name => {} if contains(vm.groups, group) }
        }
      }
    }
  }
}

resource "local_file" "inventory" {
  count = var.inventory_path == null ? 0 : 1

  filename        = var.inventory_path
  content         = "# Generated by Terraform (modules/fleet). Do not edit.\n${yamlencode(local.inventory)}"
  file_permission = "0644"
}

locals {
  ansible_dir = var.ansible_playbook == null ? null : dirname(var.ansible_playbook)
}

# Re-runs the playbook when a VM is created/replaced, a VM's settings change,
# or anything in the playbook's directory changes. Not keyed on the inventory
# itself: the reported IP flips from DHCP to the fixed one after the first run.
resource "terraform_data" "ansible" {
  count = var.ansible_playbook == null ? 0 : 1

  triggers_replace = {
    vm_ids    = { for name, vm in module.vm : name => vm.ids[name] }
    settings  = sha256(jsonencode([var.vms, var.network, var.ansible_vars]))
    playbooks = sha256(join("", [for f in sort(fileset(local.ansible_dir, "**")) : filesha256("${local.ansible_dir}/${f}")]))
  }

  provisioner "local-exec" {
    working_dir = local.ansible_dir
    command     = "ansible-playbook -i '${local_file.inventory[0].filename}' '${var.ansible_playbook}'"
    environment = {
      ANSIBLE_CONFIG = "${local.ansible_dir}/ansible.cfg"
    }
  }

  lifecycle {
    precondition {
      condition     = var.inventory_path != null
      error_message = "ansible_playbook needs inventory_path to be set."
    }
  }
}
